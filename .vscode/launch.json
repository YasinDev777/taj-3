{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Start Development Environment",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "start:dev"],
        "cwd": "${workspaceFolder}"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Start Production Environment",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "start:prod"],
        "cwd": "${workspaceFolder}"
      }
    ]
  }
  